APP_URL=http://localhost:4200
CLIENT_BOOKING_MANAGE_URL=http://localhost:3001/moje-wizyty
CLIENT_ACCOUNT_URL=http://localhost:3001/konto

# Baza danych
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=nestjs_typeorm
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
MYSQL_SYNCHRONIZE=false

# Aplikacja
NODE_ENV=development
PORT=3000

# JWT
JWT_ACCESS_TOKEN_SECRET_KEY=example_access_secret
JWT_REFRESH_TOKEN_SECRET_KEY=example_refresh_secret
JWT_CLIENT_ACCESS_TOKEN_SECRET_KEY=example_client_access_secret
JWT_ACCESS_TOKEN_EXPIRES_IN=20s
JWT_REFRESH_TOKEN_EXPIRES_IN=1h

# Mailtrap https://mailtrap.io/
MAILTRAP_API_KEY=example_api_key
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=example_inbox_id
MAIL_FROM=noreply@hairdresser.com